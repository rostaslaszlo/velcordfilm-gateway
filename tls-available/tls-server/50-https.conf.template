# Rendered by docker-entrypoint.d/45-tls.sh (sed substitution of __TLS_DOMAIN__)
# into /etc/nginx/conf.d/tls-server/50-https.conf, only once a real cert
# exists for that domain. Shares routing rules with the plain-HTTP server via
# snippets/proxy-locations.conf instead of duplicating them.
server {
    listen 443 ssl;
    server_name _;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/__TLS_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__TLS_DOMAIN__/privkey.pem;

    proxy_http_version 1.1;
    proxy_set_header Connection         "";
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Staging-only server-szintű config (basic auth, noindex, AI bot tiltás) –
    # üres production-ben. Ugyanez a directory a plain-HTTP blokkban is
    # includeolva van (lásd ../../nginx.conf) - enélkül a HTTP->HTTPS redirect
    # miatt a valódi forgalom sosem futott volna át a basic auth-on.
    include /etc/nginx/conf.d/server-extra/*.conf;

    include /etc/nginx/snippets/proxy-locations.conf;
}
